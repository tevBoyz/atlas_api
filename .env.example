# Atlas API configuration (API-100-02). Key names and safe defaults only — never real values.
# Real values live in a local .env (never committed) or the host's secret store.
# Validated at startup (src/config/config.schema.ts): an invalid or missing key stops the process
# and the error names the key, never its value. An empty value (KEY=) counts as unset.
# Runtime business settings (live-location interval, etc.) live in the app_config table, not here.

# --- Runtime -------------------------------------------------------------------------------
# development | test | production (default development)
NODE_ENV=development
# HTTP port, 1-65535 (default 3000)
PORT=3000
# fatal | error | warn | info | debug | trace | silent (default info)
LOG_LEVEL=info
# Fastify trustProxy: true | false | hop count (e.g. 1) | comma-separated IPs/CIDRs (default false)
TRUST_PROXY=false

# --- Database (required when NODE_ENV=production) --------------------------------------------
# postgres:// or postgresql:// URL. SECRET. Never point local dev/tests at production.
# The db:* scripts refuse any host other than localhost / 127.0.0.1 / ::1, and use the local
# docker database below when DATABASE_URL is unset. A real environment variable overrides .env.
# Local dev value (docker-compose.yml, throwaway credentials): put it on the DATABASE_URL line.
#   postgresql://postgres:postgres@127.0.0.1:54329/postgres
DATABASE_URL=
# Max pool connections, 1-1000 (default 10)
DATABASE_POOL_MAX=10

# --- Redis (required when NODE_ENV=production) ------------------------------------------------
# redis:// or rediss:// URL. SECRET if it carries a password.
# Local dev value (docker-compose.yml): put it on the REDIS_URL line.
#   redis://127.0.0.1:63799
REDIS_URL=

# --- Production safety (API-100-07) -------------------------------------------------------------
# Outside NODE_ENV=production the API refuses to start when DATABASE_URL or REDIS_URL names a host
# other than localhost / 127.0.0.1 / ::1 (the error names the key and host, never credentials).
# true lifts that rule. Only for an approved step on Dawit's instruction; never for local dev/tests.
# true | false (default false)
ALLOW_REMOTE_DATA_STORES=false

# --- Supabase (Postgres host, avatar Storage, transition-period JWTs) --------------------------
# Project URL, https://<ref>.supabase.co (required when NODE_ENV=production)
SUPABASE_URL=
# At least one of JWKS URL / JWT secret is required when NODE_ENV=production.
SUPABASE_JWT_JWKS_URL=
# Legacy HS256 secret, at least 32 characters. SECRET.
SUPABASE_JWT_SECRET=
# Expected `iss`, e.g. https://<ref>.supabase.co/auth/v1 (required when NODE_ENV=production)
SUPABASE_JWT_ISSUER=
# Expected `aud` (default authenticated)
SUPABASE_JWT_AUDIENCE=authenticated
# Server-side Storage key for signed avatar URLs. SECRET. Optional until the avatars story.
SUPABASE_STORAGE_SERVICE_KEY=
# Storage bucket for avatars (default avatars)
AVATARS_BUCKET=avatars

# --- Links ------------------------------------------------------------------------------------
# Base of invite links (default io.supabase.atlasmobile://invite/)
INVITE_URL_BASE=io.supabase.atlasmobile://invite/

# --- Observability (optional; API-100-06) --------------------------------------------------------
# Sentry DSN, http(s) URL. Empty = Sentry is not loaded and nothing is sent. SECRET-ish: never commit.
SENTRY_DSN=
# OpenTelemetry OTLP/HTTP base endpoint, http(s) URL (traces go to <endpoint>/v1/traces).
# Empty = no OpenTelemetry SDK is started.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Git commit hash (7-40 hex) used as the Sentry / OTel release. Optional: normally recorded at build
# time in dist/build-info.json (from this variable or `git rev-parse HEAD`); this overrides it.
GIT_COMMIT=

# --- Notification channels: true | false (all default false; providers on hold) ----------------
CHANNEL_PUSH_ENABLED=false
CHANNEL_SMS_ENABLED=false
CHANNEL_EMAIL_ENABLED=false
