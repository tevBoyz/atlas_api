# Atlas API configuration (API-100-02). Key names and safe defaults only — never real values.
# Real values live in a local .env (never committed) or the host's secret store.
# Validated at startup (src/config/config.schema.ts): an invalid or missing key stops the process
# and the error names the key, never its value. An empty value (KEY=) counts as unset.
# Runtime business settings (live-location interval, etc.) live in the app_config table, not here.

# --- Runtime -------------------------------------------------------------------------------
# development | test | production (default development)
NODE_ENV=development
# HTTP port, 1-65535 (default 3000)
PORT=3000
# fatal | error | warn | info | debug | trace | silent (default info)
LOG_LEVEL=info
# Fastify trustProxy: true | false | hop count (e.g. 1) | comma-separated IPs/CIDRs (default false)
TRUST_PROXY=false

# Serve GET /v1/openapi.json: true | false (default true). Never served when NODE_ENV=production.
OPENAPI_ENABLED=true

# --- Rate limits (API-100-11) --------------------------------------------------------------------
# Requests allowed per sliding window, per key. Health routes are never limited. When Redis is down
# or slower than RATE_LIMIT_REDIS_TIMEOUT_MS the limiter lets requests through (an SOS is never
# refused because of the limiter).
# Authenticated routes, per user (default 300 / 60 s)
RATE_LIMIT_AUTHENTICATED_MAX=300
RATE_LIMIT_AUTHENTICATED_WINDOW_SECONDS=60
# Public routes such as the invite status, per IP (default 60 / 300 s)
RATE_LIMIT_PUBLIC_MAX=60
RATE_LIMIT_PUBLIC_WINDOW_SECONDS=300
# Location pings, per user per incident (default 30 / 60 s)
RATE_LIMIT_LOCATION_PING_MAX=30
RATE_LIMIT_LOCATION_PING_WINDOW_SECONDS=60
# SOS submit and mark safe, per user (default 30 / 60 s; high on purpose)
RATE_LIMIT_EMERGENCY_WRITE_MAX=30
RATE_LIMIT_EMERGENCY_WRITE_WINDOW_SECONDS=60
# Requests rejected by authentication (bad or expired tokens), per IP (default 120 / 60 s)
RATE_LIMIT_AUTH_FAILURE_MAX=120
RATE_LIMIT_AUTH_FAILURE_WINDOW_SECONDS=60
# Signed avatar upload URLs (POST /v1/me/avatar/upload-url), per user (default 20 / 3600 s)
RATE_LIMIT_AVATAR_UPLOAD_MAX=20
RATE_LIMIT_AVATAR_UPLOAD_WINDOW_SECONDS=3600
# Longest wait for Redis in milliseconds, 1-5000 (default 100)
RATE_LIMIT_REDIS_TIMEOUT_MS=100

# --- Database (required when NODE_ENV=production) --------------------------------------------
# postgres:// or postgresql:// URL. SECRET. Never point local dev/tests at production.
# The db:* scripts refuse any host other than localhost / 127.0.0.1 / ::1, and use the local
# docker database below when DATABASE_URL is unset. A real environment variable overrides .env.
# Local dev value (docker-compose.yml, throwaway credentials): put it on the DATABASE_URL line.
#   postgresql://postgres:postgres@127.0.0.1:54329/postgres
DATABASE_URL=
# Max pool connections, 1-1000 (default 10)
DATABASE_POOL_MAX=10

# --- Redis (required when NODE_ENV=production) ------------------------------------------------
# redis:// or rediss:// URL. SECRET if it carries a password.
# Local dev value (docker-compose.yml): put it on the REDIS_URL line.
#   redis://127.0.0.1:63799
REDIS_URL=

# --- Production safety (API-100-07) -------------------------------------------------------------
# Outside NODE_ENV=production the API refuses to start when DATABASE_URL or REDIS_URL names a host
# other than localhost / 127.0.0.1 / ::1 (the error names the key and host, never credentials).
# true lifts that rule. Only for an approved step on Dawit's instruction; never for local dev/tests.
# true | false (default false)
ALLOW_REMOTE_DATA_STORES=false

# --- Supabase (Postgres host and avatar Storage; its access tokens are retired, D76) ------------
# Project URL, https://<ref>.supabase.co (required when NODE_ENV=production)
SUPABASE_URL=
# Server-side Storage key (the project's secret / service_role key) for signed avatar upload URLs,
# object checks and deletes (API-100-37). SECRET: host secret store only, never logged. Required
# when NODE_ENV=production; optional in development (avatar routes then answer 503
# profiles:avatar_storage_unavailable unless AVATAR_STORAGE=memory).
SUPABASE_STORAGE_SERVICE_KEY=
# Where profile photos go: supabase | memory (default supabase). memory = an in-process fake for
# tests and local manual testing (nothing leaves the process; refused when NODE_ENV=production).
AVATAR_STORAGE=supabase
# Storage bucket for avatars (default avatars)
AVATARS_BUCKET=avatars

# --- Links ------------------------------------------------------------------------------------
# Base of invite links (default io.supabase.atlasmobile://invite/)
INVITE_URL_BASE=io.supabase.atlasmobile://invite/

# --- Realtime (API-100-39) ----------------------------------------------------------------------
# Socket.IO namespace /v1/realtime on the same port, fanned out through Redis (REDIS_URL).
# Channel prefix of the Redis adapter: every API instance of one environment must use the same value
# (default atlas:realtime). 1-64 letters, digits, ":", ".", "_" or "-".
REALTIME_ADAPTER_KEY=atlas:realtime

# --- Observability (optional; API-100-06)--------------------------------------------------------
# Sentry DSN, http(s) URL. Empty = Sentry is not loaded and nothing is sent. SECRET-ish: never commit.
SENTRY_DSN=
# OpenTelemetry OTLP/HTTP base endpoint, http(s) URL (traces go to <endpoint>/v1/traces).
# Empty = no OpenTelemetry SDK is started.
OTEL_EXPORTER_OTLP_ENDPOINT=
# Git commit hash (7-40 hex) used as the Sentry / OTel release. Optional: normally recorded at build
# time in dist/build-info.json (from this variable or `git rev-parse HEAD`); this overrides it.
GIT_COMMIT=

# --- Jobs (API-100-45) ----------------------------------------------------------------------------
# 1 = run the BullMQ workers (fan-out and sends) instead of the HTTP server: same build and image,
# e.g. a second container with WORKER=1. 1 | 0 | true | false (default false)
WORKER=false
# true = run the HTTP server AND the BullMQ workers in ONE process (single-service test hosting,
# D82; Dockerfile.render sets it). Never together with WORKER=1. true | false (default false)
RUN_WORKERS=false
# Key prefix of the BullMQ queues in Redis (REDIS_URL). Every API and worker process of one
# environment uses the same value (default atlas:jobs).
JOBS_QUEUE_PREFIX=atlas:jobs
# Jobs each worker runs at a time, per queue, 1-100 (default 10)
JOBS_WORKER_CONCURRENCY=10
# The outbox relay publishes committed notification_outbox rows this often (and right after each
# committed incident write), 50-60000 ms (default 1000); rows per batch 1-1000 (default 100)
OUTBOX_RELAY_INTERVAL_MS=1000
OUTBOX_RELAY_BATCH_SIZE=100

# --- Delivery retries (API-100-47) -----------------------------------------------------------------
# Retries after the first attempt, 0-10 (default 3), with exponential backoff from the base delay
# (default 2000 ms: 2 s, 4 s, 8 s). All retries must fit in 60 s (base * (2^retries - 1) <= 60000).
NOTIFICATIONS_RETRY_ATTEMPTS=3
NOTIFICATIONS_RETRY_BASE_DELAY_MS=2000
# Longest wait for one provider call, 100-30000 ms (default 10000)
NOTIFICATIONS_SEND_TIMEOUT_MS=10000

# --- Notification channels (API-100-46): true | false (all default false; providers on hold) ------
# A disabled channel calls no provider: its deliveries are recorded `skipped`. Keep all three false in
# every deployed environment until Dawit lifts the hold for that provider.
CHANNEL_PUSH_ENABLED=false
CHANNEL_SMS_ENABLED=false
CHANNEL_EMAIL_ENABLED=false
# Which adapter sends: fake (default; in-process, nothing leaves it) or the real provider.
# Production refuses an enabled channel on the fake adapter.
# fake | real (real = FCM for fcm tokens and/or APNs for apns tokens, with their keys below)
CHANNEL_PUSH_ADAPTER=fake
# fake | twilio (twilio also needs CHANNEL_SMS_TWILIO_HOLD_LIFTED=true and the Twilio keys)
CHANNEL_SMS_ADAPTER=fake
# The Twilio hold: the Twilio adapter is refused at startup unless this is true. true | false
CHANNEL_SMS_TWILIO_HOLD_LIFTED=false
# FCM HTTP v1 service account (all three or none). FCM_PRIVATE_KEY is SECRET (PEM; line breaks
# may be written as the two characters backslash and n).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
# APNs token auth (all four or none). APNS_PRIVATE_KEY is SECRET (.p8 PEM; line breaks as for FCM).
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_BUNDLE_ID=
# production | sandbox (default production)
APNS_ENVIRONMENT=production
# Email adapter (D43): fake (default; in-process, nothing leaves it) | sendgrid (SendGrid v3 Mail
# Send; needs SENDGRID_API_KEY and EMAIL_FROM_ADDRESS). Every email goes through it: the auth links
# (verification, magic link, password reset) and notification emails. Sends only when
# CHANNEL_EMAIL_ENABLED=true. See docs/phase7_handoff.md §7.7a before switching it on.
CHANNEL_EMAIL_ADAPTER=fake
# SendGrid API key (SECRET; "Mail Send" permission only). Host secret store only, never in the repo.
SENDGRID_API_KEY=
# Default https://api.sendgrid.com. Only tests point it elsewhere (a local fake server); production
# requires https.
SENDGRID_API_BASE_URL=
# Sender: an address on a domain authenticated in SendGrid (or a verified single sender), and an
# optional display name (e.g. Atlas).
EMAIL_FROM_ADDRESS=
EMAIL_FROM_NAME=
# Twilio Programmable Messaging. TWILIO_AUTH_TOKEN is SECRET. TWILIO_FROM_NUMBER is E.164.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Twilio Verify service SID for phone OTP (API-100-53), VA + 32 hex. Only used by the Twilio adapter
# (still under the Twilio hold). Without it OTP routes answer 503 auth:sms_unavailable on Twilio.
TWILIO_VERIFY_SERVICE_SID=

# --- Own authentication (Phase 6, API-100-51 to 59) ---------------------------------------------
# Signing keys of the API's access tokens. SECRET: host secret store only, never in the repo.
# A JSON array of JWKs, each with a "kid": Ed25519 (kty OKP) or P-256 (kty EC). Keys with their
# private part "d" can sign; keys without it only verify. Every key's PUBLIC part is published at
# GET /v1/auth/.well-known/jwks.json. Required (with AUTH_JWT_ACTIVE_KID) when NODE_ENV=production.
# Make a key: npm run -s auth:keygen -- --kid <kid>   (prints one JWK; paste it into the array)
# Rotation: add the new key, deploy (published before use); set AUTH_JWT_ACTIVE_KID to it, deploy;
# remove the old key after AUTH_ACCESS_TOKEN_TTL_SECONDS + AUTH_JWT_CLOCK_SKEW_SECONDS.
AUTH_JWT_KEYS=
# The kid of AUTH_JWT_KEYS that signs new access tokens (it must have "d").
AUTH_JWT_ACTIVE_KID=
# iss / aud of own access tokens (defaults atlas-api / atlas-app).
AUTH_JWT_ISSUER=atlas-api
AUTH_JWT_AUDIENCE=atlas-app
# Access token lifetime in seconds, 60-3600 (default 900 = 15 min); clock skew 0-30 (default 30).
AUTH_ACCESS_TOKEN_TTL_SECONDS=900
AUTH_JWT_CLOCK_SKEW_SECONDS=30
# Refresh tokens: lifetime in days (default 30); a session not refreshed for this many days ends
# (default 7, decision D7).
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_SESSION_IDLE_DAYS=7
# Email links (verification, magic link, password reset): lifetime in seconds (default 300) and the
# app's callback (scheme kept for app compatibility).
AUTH_EMAIL_LINK_TTL_SECONDS=300
AUTH_LINK_BASE=io.supabase.atlasmobile://login-callback/
# TEST ONLY: serves GET /__test/auth-messages (what the FAKE email/SMS adapters "sent": verification
# links and OTP codes) for automated tests and the manual guide. Refused when NODE_ENV=production.
AUTH_TEST_MAILBOX_ENABLED=false
# Google sign-in (API-100-55): the OAuth client ids allowed as `aud` (Web, Android, iOS),
# comma-separated. Empty = Google sign-in answers 503 auth:provider_disabled.
GOOGLE_CLIENT_IDS=
# Google's public keys (default https://www.googleapis.com/oauth2/v3/certs).
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
# Apple sign-in: off by default (503 auth:provider_disabled). When true, APPLE_CLIENT_IDS (the app's
# bundle id / services id) is required.
APPLE_SIGN_IN_ENABLED=false
APPLE_CLIENT_IDS=
APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
