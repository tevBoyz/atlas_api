{
  "components": {
    "schemas": {
      "EmergencyType": {
        "enum": [
          "medical",
          "domestic_violence",
          "fire",
          "burglary",
          "other",
          "unspecified"
        ],
        "type": "string"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string"
          },
          "details": {
            "additionalProperties": {},
            "propertyNames": {
              "type": "string"
            },
            "type": "object"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "code",
          "message",
          "details"
        ],
        "type": "object"
      },
      "ErrorEnvelope": {
        "description": "The body of every non-2xx response (spec §11.2).",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": [
          "error"
        ],
        "type": "object"
      },
      "HealthOk": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "const": "ok",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      },
      "IncidentStatus": {
        "enum": [
          "active",
          "resolved",
          "activating",
          "cancelled"
        ],
        "type": "string"
      },
      "InviteLookupStatus": {
        "enum": [
          "pending",
          "consumed",
          "canceled",
          "expired",
          "not_found"
        ],
        "type": "string"
      },
      "LocationSource": {
        "enum": [
          "current",
          "last_known",
          "unavailable"
        ],
        "type": "string"
      },
      "MemberStatus": {
        "enum": [
          "active",
          "pending",
          "expired",
          "declined"
        ],
        "type": "string"
      },
      "OpenApiDocument": {
        "additionalProperties": {},
        "properties": {},
        "type": "object"
      },
      "PingResponse": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string"
          },
          "user_id": {
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "type": "string"
          }
        },
        "required": [
          "status",
          "user_id"
        ],
        "type": "object"
      },
      "ReadinessUnavailable": {
        "additionalProperties": false,
        "properties": {
          "failed": {
            "items": {
              "enum": [
                "db",
                "redis",
                "migrations"
              ],
              "type": "string"
            },
            "type": "array"
          },
          "status": {
            "const": "unavailable",
            "type": "string"
          }
        },
        "required": [
          "status",
          "failed"
        ],
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearerAuth": {
        "bearerFormat": "JWT",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "Atlas backend API. JSON properties are snake_case. Every non-2xx response uses the error envelope; `error.code` keeps the `fn:code` strings of the original SQL functions.",
    "title": "Atlas API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOk"
                }
              }
            },
            "description": "Up"
          },
          "500": {
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "internal:error",
                    "details": {},
                    "message": "Something went wrong. Try again later."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unexpected error",
            "x-error-codes": [
              "internal:error"
            ]
          }
        },
        "security": [],
        "summary": "Liveness: the process is up",
        "tags": [
          "health"
        ]
      }
    },
    "/readyz": {
      "get": {
        "operationId": "getReadiness",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOk"
                }
              }
            },
            "description": "Ready"
          },
          "500": {
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "internal:error",
                    "details": {},
                    "message": "Something went wrong. Try again later."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unexpected error",
            "x-error-codes": [
              "internal:error"
            ]
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessUnavailable"
                }
              }
            },
            "description": "A dependency failed"
          }
        },
        "security": [],
        "summary": "Readiness: database, Redis and migrations",
        "tags": [
          "health"
        ]
      }
    },
    "/v1/openapi.json": {
      "get": {
        "operationId": "getOpenApiDocument",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpenApiDocument"
                }
              }
            },
            "description": "OpenAPI 3.1 document"
          },
          "404": {
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "http:not_found",
                    "details": {},
                    "message": "Not found."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Not found",
            "x-error-codes": [
              "http:not_found"
            ]
          },
          "429": {
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "rate_limit:exceeded",
                    "details": {},
                    "message": "Too many requests. Try again later."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Too many requests",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "minimum": 0,
                  "type": "integer"
                }
              }
            },
            "x-error-codes": [
              "rate_limit:exceeded"
            ]
          },
          "500": {
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "internal:error",
                    "details": {},
                    "message": "Something went wrong. Try again later."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unexpected error",
            "x-error-codes": [
              "internal:error"
            ]
          }
        },
        "security": [],
        "summary": "The OpenAPI document of this API (never served in production)",
        "tags": [
          "meta"
        ]
      }
    },
    "/v1/ping": {
      "get": {
        "operationId": "ping",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PingResponse"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "ping:not_authenticated",
                    "details": {},
                    "message": "Sign in to continue."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Missing, invalid or expired access token",
            "x-error-codes": [
              "ping:not_authenticated"
            ]
          },
          "429": {
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "rate_limit:exceeded",
                    "details": {},
                    "message": "Too many requests. Try again later."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Too many requests",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before retrying.",
                "schema": {
                  "minimum": 0,
                  "type": "integer"
                }
              }
            },
            "x-error-codes": [
              "rate_limit:exceeded"
            ]
          },
          "500": {
            "content": {
              "application/json": {
                "example": {
                  "error": {
                    "code": "internal:error",
                    "details": {},
                    "message": "Something went wrong. Try again later."
                  }
                },
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Unexpected error",
            "x-error-codes": [
              "internal:error"
            ]
          }
        },
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "summary": "Scaffold route: echoes the authenticated caller",
        "tags": [
          "meta"
        ]
      }
    }
  },
  "servers": [
    {
      "url": "/"
    }
  ]
}
