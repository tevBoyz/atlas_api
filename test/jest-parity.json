{
  "displayName": "parity",
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "roots": ["<rootDir>/test/parity"],
  "testMatch": ["**/*.spec.ts"],
  "transform": {
    "^.+[.]ts$": "ts-jest"
  },
  "testEnvironment": "node",
  "testTimeout": 30000,
  "globalSetup": "<rootDir>/test/support/global-setup.ts",
  "globalTeardown": "<rootDir>/test/support/global-teardown.ts",
  "setupFiles": ["<rootDir>/test/support/worker-env.ts"],
  "setupFilesAfterEnv": ["<rootDir>/test/support/worker-isolation.ts"]
}
