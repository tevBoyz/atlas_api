{
  "displayName": "unit",
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "roots": ["<rootDir>/src"],
  "testMatch": ["**/*.spec.ts"],
  "transform": {
    "^.+[.]ts$": "ts-jest"
  },
  "collectCoverageFrom": ["src/**/*.ts"],
  "coverageDirectory": "./coverage",
  "testEnvironment": "node",
  "setupFiles": ["<rootDir>/src/testing/unit-env.ts"]
}
