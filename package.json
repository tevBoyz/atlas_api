{
  "name": "atlas-api",
  "version": "0.1.0",
  "description": "Atlas backend API (NestJS on Fastify)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.json",
    "test:int": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config test/jest-int.json --passWithNoTests",
    "test:parity": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config test/jest-parity.json --passWithNoTests"
  },
  "dependencies": {
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-fastify": "12.3.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.12",
    "@nestjs/testing": "12.3.2",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "ts-jest": "29.4.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
