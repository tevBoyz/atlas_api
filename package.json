{
  "name": "atlas-api",
  "version": "0.1.0",
  "description": "Atlas backend API (NestJS on Fastify)",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "scripts": {
    "build": "nest build",
    "postbuild": "node dist/observability/write-build-info.js && node dist/health/write-migrations-manifest.js",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.json",
    "test:int": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config test/jest-int.json --passWithNoTests",
    "test:parity": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config test/jest-parity.json --passWithNoTests",
    "test:baseline": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config test/jest-baseline.json",
    "db:setup": "tsx src/db/tooling/cli.ts setup",
    "db:baseline": "tsx src/db/tooling/cli.ts baseline",
    "db:baseline:verify": "tsx src/db/tooling/cli.ts verify",
    "db:baseline:manifest": "tsx src/db/tooling/cli.ts manifest",
    "db:migrate": "tsx src/db/tooling/cli.ts migrate",
    "db:seed": "tsx src/db/tooling/cli.ts seed",
    "db:test:sql": "tsx src/db/tooling/cli.ts test-sql",
    "openapi:generate": "tsx src/openapi/cli.ts write",
    "openapi:check": "tsx src/openapi/cli.ts check",
    "client:dart:generate": "tsx src/openapi/dart-client.ts generate",
    "client:dart:build": "tsx src/openapi/dart-client.ts build",
    "auth:test-token": "tsx src/testing/mint-test-token.ts",
    "db:introspect": "drizzle-kit pull --config drizzle.config.ts && tsx src/db/tooling/assemble-schema.ts && prettier --write src/db/schema.ts",
    "parity:report": "tsx test/tools/parity-report.ts",
    "load:incidents": "tsx test/load/incident-load.ts",
    "load:circles": "tsx test/load/circles-load.ts",
    "load:profiles": "tsx test/load/profiles-load.ts",
    "load:realtime": "tsx test/load/realtime-load.ts",
    "load:notifications": "tsx test/load/notifications-load.ts"
  },
  "dependencies": {
    "@fastify/otel": "1.0.1",
    "@nestjs/common": "12.3.2",
    "@nestjs/config": "12.1.1",
    "@nestjs/core": "12.3.2",
    "@nestjs/platform-fastify": "12.3.2",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "0.301.2",
    "@opentelemetry/instrumentation-http": "0.301.2",
    "@opentelemetry/instrumentation-ioredis": "0.73.0",
    "@opentelemetry/instrumentation-pg": "0.78.0",
    "@opentelemetry/resources": "3.1.1",
    "@opentelemetry/sdk-node": "0.301.2",
    "@opentelemetry/semantic-conventions": "1.45.0",
    "@sentry/node": "11.14.0",
    "@socket.io/redis-adapter": "8.3.0",
    "bullmq": "6.7.8",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.7",
    "ioredis": "6.0.0",
    "jose": "6.2.17",
    "nestjs-pino": "5.3.2",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "socket.io": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.12",
    "@nestjs/testing": "12.3.2",
    "@types/jest": "30.0.0",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.14.0",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "socket.io-client": "4.8.4",
    "testcontainers": "12.2.1",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  }
}
